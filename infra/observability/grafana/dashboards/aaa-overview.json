{
  "title": "AAA — Audit Pipeline Overview",
  "uid": "aaa-overview",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "aaa"
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Prometheus targets",
      "type": "link",
      "url": "http://127.0.0.1:9090/targets",
      "targetBlank": true
    },
    {
      "title": "Prometheus alerts",
      "type": "link",
      "url": "http://127.0.0.1:9090/alerts",
      "targetBlank": true
    },
    {
      "title": "Langfuse traces",
      "type": "link",
      "url": "http://localhost:3003",
      "targetBlank": true
    },
    {
      "title": "Alloy pipeline",
      "type": "link",
      "url": "http://127.0.0.1:12345",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Pipeline health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "title": "API scrape",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "up{job=\"aaa_api\"}",
          "legendFormat": "aaa_api",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Prometheus reaching the FastAPI /metrics endpoint. DOWN means the API is not running — nothing below can update until it is (`python -m aaa`)."
    },
    {
      "id": 2,
      "title": "Observability stack",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "up{job=~\"prometheus|loki|alloy|grafana\"}",
          "legendFormat": "{{job}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Self-scrape of the obs profile containers."
    },
    {
      "id": 3,
      "title": "Engagements by final verdict",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum(aaa_engagements_total) by (final_verdict)",
          "legendFormat": "{{final_verdict}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "aaa_engagements_total — incremented once per completed /run (api/routes/workflow/finish.py). Empty until the first engagement completes on this stack."
    },
    {
      "id": 4,
      "title": "Cumulative LLM cost (USD)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum(aaa_llm_cost_usd_total)",
          "legendFormat": "USD",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "aaa_llm_cost_usd_total — sum of estimated_cost_usd across every priced call. Calls LiteLLM cannot price add 0 here and are recorded as null in llm_audit.jsonl (cost_basis)."
    },
    {
      "id": 101,
      "type": "row",
      "title": "LLM calls (agents/base/audit.py)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 5,
      "title": "LLM calls / s by agent and status",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(aaa_llm_calls_total[5m])) by (agent, status)",
          "legendFormat": "{{agent}} ({{status}})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "LLM latency p50 / p95 by agent",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(aaa_llm_latency_seconds_bucket[5m])) by (le, agent))",
          "legendFormat": "p50 {{agent}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(aaa_llm_latency_seconds_bucket[5m])) by (le, agent))",
          "legendFormat": "p95 {{agent}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Tokens / s by type",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(aaa_llm_tokens_total[5m])) by (token_type)",
          "legendFormat": "{{token_type}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "LLM calls by model (total, 24h window)",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(increase(aaa_llm_calls_total[24h])) by (model)",
          "legendFormat": "{{model}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Which model actually served the calls — the roster is switched by PROVIDER / OPENROUTER_MODEL and this is the place to confirm a run used the intended one."
    },
    {
      "id": 9,
      "title": "LLM error ratio (10m)",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(aaa_llm_calls_total{status=\"error\"}[10m])) / clamp_min(sum(rate(aaa_llm_calls_total[10m])), 1e-9)",
          "legendFormat": "error ratio",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Feeds the AAALLMErrorRatioHigh alert (infra/observability/rules/aaa-alerts.yml)."
    },
    {
      "id": 102,
      "type": "row",
      "title": "Phases and errors",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "panels": []
    },
    {
      "id": 10,
      "title": "Phase latency p95 by phase",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(aaa_phase_latency_seconds_bucket[15m])) by (le, phase))",
          "legendFormat": "{{phase}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "aaa_phase_latency_seconds — observed by phases/verification/finish_phase.py at the end of every phase."
    },
    {
      "id": 11,
      "title": "Phase outcomes (verdict, 24h window)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 22
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(increase(aaa_phases_total[24h])) by (phase, verdict)",
          "legendFormat": "{{phase}}: {{verdict}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "aaa_phases_total{phase, verdict} — pass / fail / escalate_hitl per phase. Was emitted but never charted."
    },
    {
      "id": 12,
      "title": "Errors / s by component",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 22
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(aaa_errors_total[5m])) by (component, exception_type)",
          "legendFormat": "{{component}} {{exception_type}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "aaa_errors_total — every capture_error() call. Records are in logs/errors/<component>.jsonl."
    },
    {
      "id": 103,
      "type": "row",
      "title": "Logs (Loki via Alloy, logs/**)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "panels": []
    },
    {
      "id": 13,
      "title": "Log lines / min by level",
      "type": "timeseries",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (level) (count_over_time({job=\"aaa\"}[1m]))",
          "legendFormat": "{{level}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range"
        }
      ],
      "description": "Every file under logs/ is JSON; Alloy extracts `level` (audit rows: derived from status)."
    },
    {
      "id": 14,
      "title": "Errors and warnings",
      "type": "logs",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "expr": "{job=\"aaa\", level=~\"error|warning\"}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "description": "Structlog / stdlib records at warning+ and failed LLM calls. Click a line to expand its JSON fields."
    },
    {
      "id": 15,
      "title": "LLM call audit (metadata — full prompt/reply in llm_audit.jsonl and Langfuse)",
      "type": "logs",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 45
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "expr": "{job=\"aaa\", filename=~\".*llm_audit\\\\.jsonl\"}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "description": "One line per LLM call: engagement_id, call_id, agent, model, status, latency, tokens, cost. Filter: `| json | engagement_id=\"eng-…\"`."
    }
  ]
}

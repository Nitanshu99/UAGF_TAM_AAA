{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:uagf:tam:T12_output_fairness_report:1.0.0",
  "title": "T12 — Output Fairness Report",
  "description": "Demographic parity, equal opportunity, disparate impact, and subgroup performance metrics. EU AI Act Art. 10 §2(f) (examination for possible biases), feeding the Art. 9 risk-management system.",
  "type": "object",
  "required": [
    "engagement_id",
    "modality",
    "sensitive_features",
    "demographic_parity",
    "equal_opportunity",
    "disparate_impact",
    "subgroup_metrics",
    "overall_fairness_verdict",
    "generated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "engagement_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for this audit engagement."
    },
    "modality": {
      "type": "string",
      "enum": [
        "tabular",
        "cv",
        "nlp",
        "time_series",
        "llm",
        "agentic",
        "gpai"
      ]
    },
    "sensitive_features": {
      "type": "array",
      "description": "Names of sensitive attributes used in fairness analysis (e.g. ['gender', 'age_group']).",
      "items": {
        "type": "string"
      }
    },
    "group_resolution": {
      "type": "array",
      "description": "How each protected attribute was grouped before its metrics were computed (fix 27): whether a continuous column was binned, how many cohorts resulted, the smallest cohort, and whether the attribute was testable at all.",
      "items": {
        "type": "object",
        "required": [
          "attribute",
          "group_count",
          "smallest_group_size",
          "tested"
        ],
        "additionalProperties": false,
        "properties": {
          "attribute": {
            "type": "string"
          },
          "group_count": {
            "type": "integer",
            "minimum": 0
          },
          "smallest_group_size": {
            "type": "integer",
            "minimum": 0
          },
          "binned": {
            "type": "boolean"
          },
          "bands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tested": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "evaluation_sample_size": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "demographic_parity": {
      "type": "object",
      "description": "Selection-rate parity across groups from demographic_parity tool.",
      "required": [
        "metric",
        "verdict",
        "sample_size"
      ],
      "additionalProperties": false,
      "properties": {
        "metric": {
          "type": "string"
        },
        "difference": {
          "type": [
            "number",
            "null"
          ]
        },
        "ratio": {
          "type": [
            "number",
            "null"
          ]
        },
        "group_rates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "group",
              "selection_rate"
            ],
            "additionalProperties": false,
            "properties": {
              "group": {
                "type": "string"
              },
              "selection_rate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "n": {
                "type": "integer",
                "minimum": 0,
                "description": "Observations in this cohort (fix 30)."
              }
            }
          }
        },
        "verdict": {
          "type": "string",
          "enum": [
            "PASS",
            "PASS_WITH_OBSERVATIONS",
            "FAIL",
            "INSUFFICIENT_EVIDENCE",
            "NOT_TESTED",
            "NOT_APPLICABLE"
          ]
        },
        "sample_size": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "positive_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence_interval": {
          "type": "object",
          "description": "Two-sided confidence interval for this metric (fix 30): the precision the sample supports, reported beside the point estimate.",
          "additionalProperties": false,
          "properties": {
            "low": {
              "type": [
                "number",
                "null"
              ]
            },
            "high": {
              "type": [
                "number",
                "null"
              ]
            },
            "level": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "groups": {
              "type": "array",
              "description": "The two cohorts the interval compares: the deciding pair.",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "comparisons": {
              "type": "integer",
              "description": "Cohort pairs compared; the level holds across all of them (Bonferroni).",
              "minimum": 1
            },
            "method": {
              "type": "string"
            }
          }
        }
      }
    },
    "equal_opportunity": {
      "type": "object",
      "description": "True-positive-rate gap across groups from equal_opportunity tool.",
      "required": [
        "metric",
        "verdict",
        "sample_size"
      ],
      "additionalProperties": false,
      "properties": {
        "metric": {
          "type": "string"
        },
        "difference": {
          "type": [
            "number",
            "null"
          ]
        },
        "tpr_by_group": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "group",
              "true_positive_rate"
            ],
            "additionalProperties": false,
            "properties": {
              "group": {
                "type": "string"
              },
              "true_positive_rate": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "n": {
                "type": "integer",
                "minimum": 0,
                "description": "Observations in this cohort (fix 30)."
              }
            }
          }
        },
        "verdict": {
          "type": "string",
          "enum": [
            "PASS",
            "PASS_WITH_OBSERVATIONS",
            "FAIL",
            "INSUFFICIENT_EVIDENCE",
            "NOT_TESTED",
            "NOT_APPLICABLE"
          ]
        },
        "sample_size": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "positive_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence_interval": {
          "type": "object",
          "description": "Two-sided confidence interval for this metric (fix 30): the precision the sample supports, reported beside the point estimate.",
          "additionalProperties": false,
          "properties": {
            "low": {
              "type": [
                "number",
                "null"
              ]
            },
            "high": {
              "type": [
                "number",
                "null"
              ]
            },
            "level": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "groups": {
              "type": "array",
              "description": "The two cohorts the interval compares: the deciding pair.",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "comparisons": {
              "type": "integer",
              "description": "Cohort pairs compared; the level holds across all of them (Bonferroni).",
              "minimum": 1
            },
            "method": {
              "type": "string"
            }
          }
        }
      }
    },
    "disparate_impact": {
      "type": "object",
      "description": "Four-fifths-rule ratio from disparate_impact tool (EEOC 1978; AIF360).",
      "required": [
        "metric",
        "verdict",
        "sample_size"
      ],
      "additionalProperties": false,
      "properties": {
        "metric": {
          "type": "string"
        },
        "ratio": {
          "type": [
            "number",
            "null"
          ]
        },
        "privileged_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "unprivileged_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "privileged_selection_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "unprivileged_selection_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "four_fifths_rule_passed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "verdict": {
          "type": "string",
          "enum": [
            "PASS",
            "PASS_WITH_OBSERVATIONS",
            "FAIL",
            "INSUFFICIENT_EVIDENCE",
            "NOT_TESTED",
            "NOT_APPLICABLE"
          ]
        },
        "sample_size": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "positive_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence_interval": {
          "type": "object",
          "description": "Two-sided confidence interval for this metric (fix 30): the precision the sample supports, reported beside the point estimate.",
          "additionalProperties": false,
          "properties": {
            "low": {
              "type": [
                "number",
                "null"
              ]
            },
            "high": {
              "type": [
                "number",
                "null"
              ]
            },
            "level": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "groups": {
              "type": "array",
              "description": "The two cohorts the interval compares: the deciding pair.",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "comparisons": {
              "type": "integer",
              "description": "Cohort pairs compared; the level holds across all of them (Bonferroni).",
              "minimum": 1
            },
            "method": {
              "type": "string"
            }
          }
        },
        "privileged_group_size": {
          "type": "integer",
          "minimum": 0
        },
        "unprivileged_group_size": {
          "type": "integer",
          "minimum": 0
        },
        "privileged_selected": {
          "type": "integer",
          "minimum": 0
        },
        "unprivileged_selected": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "subgroup_metrics": {
      "type": "object",
      "description": "Per-group accuracy/selection-rate/TPR/FPR breakdown.",
      "required": [
        "metric",
        "verdict",
        "sample_size"
      ],
      "additionalProperties": false,
      "properties": {
        "metric": {
          "type": "string"
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "group",
              "size",
              "accuracy",
              "selection_rate",
              "true_positive_rate",
              "false_positive_rate"
            ],
            "additionalProperties": false,
            "properties": {
              "group": {
                "type": "string"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "accuracy": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "selection_rate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "true_positive_rate": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "false_positive_rate": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "accuracy_gap": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "worst_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "best_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "verdict": {
          "type": "string",
          "enum": [
            "PASS",
            "PASS_WITH_OBSERVATIONS",
            "FAIL",
            "INSUFFICIENT_EVIDENCE",
            "NOT_TESTED",
            "NOT_APPLICABLE"
          ]
        },
        "sample_size": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "positive_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence_interval": {
          "type": "object",
          "description": "Two-sided confidence interval for this metric (fix 30): the precision the sample supports, reported beside the point estimate.",
          "additionalProperties": false,
          "properties": {
            "low": {
              "type": [
                "number",
                "null"
              ]
            },
            "high": {
              "type": [
                "number",
                "null"
              ]
            },
            "level": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "groups": {
              "type": "array",
              "description": "The two cohorts the interval compares: the deciding pair.",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "comparisons": {
              "type": "integer",
              "description": "Cohort pairs compared; the level holds across all of them (Bonferroni).",
              "minimum": 1
            },
            "method": {
              "type": "string"
            }
          }
        }
      }
    },
    "overall_fairness_verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "PASS_WITH_OBSERVATIONS",
        "FAIL",
        "INSUFFICIENT_EVIDENCE",
        "NOT_TESTED",
        "NOT_APPLICABLE"
      ],
      "description": "Aggregate fairness verdict across all metrics for Art. 10 §2(f) / Art. 15 §1 compliance."
    },
    "fairness_narrative": {
      "type": [
        "string",
        "null"
      ],
      "description": "Free-text narrative summarising fairness findings and Article alignment."
    },
    "skipped_reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "If fairness analysis could not be executed (e.g. no labelled eval set or no sensitive feature) this explains why."
    },
    "art10_2f_compliance_notes": {
      "type": [
        "string",
        "null"
      ],
      "description": "Notes on the Art. 10 §2(f) bias-examination obligation, including when the examination was not performed."
    },
    "art9_compliance_notes": {
      "type": [
        "string",
        "null"
      ],
      "description": "Notes on the Art. 9 risk-management system this fairness result feeds. Attribution only — Phase 4 does not assess Art. 9 conformity."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp when this artefact was generated."
    }
  }
}
